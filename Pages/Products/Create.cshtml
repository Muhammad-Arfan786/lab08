@page
@model Books_Management_System.Pages.Products.CreateModel
@{
    ViewData["Title"] = "Add Product";
}
<div class="form-heading">
    <p class="eyebrow mb-1">CATALOGUE</p>
    <h1>Add Product</h1>
    <p class="text-muted">Enter the product information below.</p>
</div>
<form method="post" enctype="multipart/form-data" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Product.Title" class="form-label">Title</label>
        <input asp-for="Product.Title" class="form-control" />
        <span asp-validation-for="Product.Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Product.description" class="form-label">Description</label>
        <textarea asp-for="Product.description" rows="3" class="form-control"></textarea>
        <span asp-validation-for="Product.description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Product Image (JPG, PNG, WEBP; max 5 MB)</label>
        <input asp-for="ImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" />
        <span asp-validation-for="ImageFile" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Product.price" class="form-label">Price</label>
            <input asp-for="Product.price" type="number" min="0" step="0.01" class="form-control" />
            <span asp-validation-for="Product.price" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Product.quantity" class="form-label">Quantity</label>
            <input asp-for="Product.quantity" type="number" min="0" class="form-control" />
            <span asp-validation-for="Product.quantity" class="text-danger"></span>
        </div>
    </div>
    <div class="mb-4">
        <label asp-for="Product.status" class="form-label">Status</label>
        <select asp-for="Product.status" class="form-select">
            <option value="A">Active</option>
            <option value="I">Inactive</option>
        </select>
        <span asp-validation-for="Product.status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save Product</button>
    <a asp-page="Index" class="btn btn-light">Cancel</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
