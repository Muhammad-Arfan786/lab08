@page "{id:int}"
@model Books_Management_System.Pages.Products.DetailsModel
@{
    ViewData["Title"] = "Product Details";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><p class="eyebrow mb-1">CATALOGUE</p><h1>Product Details</h1></div>
    <a asp-page="Index" class="btn btn-light">Back to Products</a>
</div>
<div class="details-card">
    @if (!string.IsNullOrWhiteSpace(Model.Product.image))
    {
        <img class="details-image" src="~/@Model.Product.image" alt="@Model.Product.Title" />
    }
    else
    {
        <div class="details-image placeholder-thumb">No image</div>
    }
    <div class="details-content">
        <h2>@Model.Product.Title</h2>
        <p class="text-muted">Product #@Model.Product.Id</p>
        <p>@(string.IsNullOrWhiteSpace(Model.Product.description) ? "No description provided." : Model.Product.description)</p>
        <dl class="row mt-4">
            <dt class="col-sm-4">Price</dt><dd class="col-sm-8">@Model.Product.price.ToString("C")</dd>
            <dt class="col-sm-4">Quantity</dt><dd class="col-sm-8">@Model.Product.quantity</dd>
            <dt class="col-sm-4">Status</dt><dd class="col-sm-8">@(Model.Product.status == "A" ? "Active" : "Inactive")</dd>
        </dl>
        <a asp-page="Edit" asp-route-id="@Model.Product.Id" class="btn btn-primary">Edit Product</a>
        <a asp-page="Delete" asp-route-id="@Model.Product.Id" class="btn btn-outline-danger">Delete</a>
    </div>
</div>
