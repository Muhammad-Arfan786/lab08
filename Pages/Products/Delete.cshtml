@page "{id:int}"
@model Books_Management_System.Pages.Products.DeleteModel
@{
    ViewData["Title"] = "Delete Product";
}
<h1>Delete Product</h1>
<div class="alert alert-warning">Are you sure you want to delete this product? This action cannot be undone.</div>
<div class="form-card mb-3">
    <h4>@Model.Product.Title</h4>
    @if (!string.IsNullOrWhiteSpace(Model.Product.image))
    {
        <img src="~/@Model.Product.image" alt="@Model.Product.Title" class="product-thumb mb-3" />
    }
    <p><strong>Price:</strong> @Model.Product.price.ToString("C")</p>
    <p><strong>Quantity:</strong> @Model.Product.quantity</p>
</div>
<form method="post">
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-page="Index" class="btn btn-light">Cancel</a>
</form>
