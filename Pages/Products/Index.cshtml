@page
@model Books_Management_System.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Products";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <p class="eyebrow mb-1">CATALOGUE</p>
        <h1 class="mb-0">Products</h1>
    </div>
    <a asp-page="Create" class="btn btn-primary">+ Add Product</a>
</div>

@if (Model.Products.Count == 0)
{
    <div class="empty-state">
        <h3>No products yet</h3>
        <p class="text-muted">Add your first product to start building the catalogue.</p>
        <a asp-page="Create" class="btn btn-primary">Add your first product</a>
    </div>
}
else
{
    <div class="table-responsive card shadow-sm">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(product.image))
                        {
                            <img class="product-thumb" src="~/@product.image" alt="@product.Title" />
                        }
                        else
                        {
                            <div class="product-thumb placeholder-thumb">No image</div>
                        }
                    </td>
                    <td>
                        <strong>@product.Title</strong>
                        <div class="small text-muted">ID: @product.Id</div>
                    </td>
                    <td>@product.price.ToString("C")</td>
                    <td>@product.quantity</td>
                    <td>
                        @if (product.status == "A")
                        {
                            <span class="badge text-bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Inactive</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-page="Details" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">Details</a>
                        <a asp-page="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-page="Delete" asp-route-id="@product.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
