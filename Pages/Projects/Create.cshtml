@page
@model Project_Management_System.Pages.Projects.CreateModel
@{
    ViewData["Title"] = "Create Project";
}
<div class="form-heading"><p class="eyebrow mb-1">NEW WORKSPACE ITEM</p><h1>Create Project</h1><p class="text-muted">Enter the project information below.</p></div>
<form method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3"><label asp-for="Project.Name" class="form-label"></label><input asp-for="Project.Name" class="form-control" placeholder="e.g. Website Redesign" /><span asp-validation-for="Project.Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Project.Description" class="form-label"></label><textarea asp-for="Project.Description" rows="4" class="form-control"></textarea><span asp-validation-for="Project.Description" class="text-danger"></span></div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Project.StartDate" class="form-label"></label><input asp-for="Project.StartDate" type="date" class="form-control" /><span asp-validation-for="Project.StartDate" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="Project.EndDate" class="form-label"></label><input asp-for="Project.EndDate" type="date" class="form-control" /><span asp-validation-for="Project.EndDate" class="text-danger"></span></div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3"><label asp-for="Project.Budget" class="form-label"></label><input asp-for="Project.Budget" type="number" min="0" step="0.01" class="form-control" /><span asp-validation-for="Project.Budget" class="text-danger"></span></div>
        <div class="col-md-6 mb-3"><label asp-for="Project.ProjectManager" class="form-label"></label><input asp-for="Project.ProjectManager" class="form-control" /></div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-4"><label asp-for="Project.Status" class="form-label"></label><select asp-for="Project.Status" class="form-select"><option>Planning</option><option>In Progress</option><option>On Hold</option><option>Completed</option><option>Cancelled</option></select></div>
        <div class="col-md-6 mb-4"><label asp-for="Project.Priority" class="form-label"></label><select asp-for="Project.Priority" class="form-select"><option>Low</option><option>Medium</option><option>High</option><option>Critical</option></select></div>
    </div>
    <button type="submit" class="btn btn-primary">Save Project</button> <a asp-page="Index" class="btn btn-light">Cancel</a>
</form>